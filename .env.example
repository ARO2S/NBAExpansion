# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Prisma - use Supabase connection string)
# Add ?pgbouncer=true if using Supabase pooled connection (port 6543) to avoid "prepared statement already exists" errors
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres?pgbouncer=true

# Admin access (comma-separated emails)
ADMIN_EMAILS=admin@example.com

# For Playwright image export (local dev: http://localhost:3000)
BASE_URL=http://localhost:3000

# Optional: licensed data providers (for Admin sync)
# SPORTRADAR_API_KEY=
SPORTSDATAIO_API_KEY=
# BallDontLie: free tier = teams & players; GOAT tier = season averages & contracts
BALLDONTLIE_API_KEY=
